# Copy to .env (repo root) — used by docker compose and by `npm run dev:api` (via apps/api/.env).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sambhav:sambhav@localhost:5432/sambhav
REDIS_URL=redis://localhost:6379
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32-xxxxxxxxxxxx
JWT_REFRESH_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32-yyyyyyyyyyyy
ATTENDANCE_KEY=replace-with-exactly-64-hex-characters-0000000000000000000000000
WEB_ORIGIN=http://localhost:5173
TOTP_STEP_SECONDS=30
# Attendance administrator (created on first seed only). Only this account can run attendance.
# The initial PIN is short by request — rotate it from Admin → Security (needs the SMS OTP).
ADMIN_USERNAME=udbhav
ADMIN_PASSWORD=1234
# Registered mobile for OTPs (E.164). Set the real number only in your private .env or host secrets.
ADMIN_PHONE=
ADMIN_EMAIL=udbhav@sambhav.club
# SMS gateway for OTPs: console (dev: code is printed in the API log) | msg91 | fast2sms | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER=
TWILIO_ACCOUNT_SID=
OTP_TTL_SECONDS=300
POSTGRES_PASSWORD=sambhav
# --- Vihaan, the AI guide (optional). Without a key Vihaan still navigates and answers FAQs (offline mode). ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Thinking counts toward max_tokens on newer models; effort is sent only to models that support it.
AI_MAX_TOKENS=1500
AI_EFFORT=low
# Pin a prompt version from the registry (blank = latest). Roll back quality issues by changing this.
AI_PROMPT_VERSION=
# Days to keep Vihaan question/answer text for quality review (admin only).
AI_LOG_RETENTION_DAYS=30
# Model calls per 10 min: per signed-in user / per IP for visitors (high: a campus shares one NAT address)
AI_USER_QUOTA=30
AI_VISITOR_QUOTA=200
# Hard ceiling on model calls per day across the site — bounds the bill
AI_DAILY_CAP=3000
# --- Security ---
# Block admin tools until a weak password (e.g. the seeded PIN) is rotated: auto = on in production.
ENFORCE_PASSWORD_CHANGE=auto
# Optional anti-proxy attendance: campus Wi-Fi egress ranges, comma-separated (blank = check in from anywhere).
CHECKIN_ALLOWED_CIDRS=
# --- Monitoring: bearer token for GET /metrics (blank = endpoint disabled); Grafana admin password ---
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# --- Production (docker-compose.prod.yml) ---
DOMAIN=sambhav.example.edu
# Single-container mode: the API serves the built SPA from this folder (set automatically in the Dockerfile).
# WEB_DIST=/repo/web
