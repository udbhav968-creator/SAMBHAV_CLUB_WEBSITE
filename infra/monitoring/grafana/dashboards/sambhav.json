{
 "uid": "sambhav-llmops",
 "title": "Sambhav \u00b7 API & Vihaan LLMOps",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "sambhav",
  "llmops"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "AI answers (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(sambhav_ai_requests_total[24h]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Instant share (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(sambhav_ai_requests_total{mode=\"instant\"}[24h])) / clamp_min(sum(increase(sambhav_ai_requests_total[24h])),1)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "AI p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sambhav_ai_latency_seconds_bucket{mode=\"ai\"}[1h])))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Helpful rate (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(sambhav_ai_feedback_total{rating=\"up\"}[24h])) / clamp_min(sum(increase(sambhav_ai_feedback_total[24h])),1)"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Spend (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(sambhav_ai_cost_usd_total[24h]))"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "API 5xx ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sambhav_http_request_duration_seconds_count{status=~\"5..\"}[15m])) / clamp_min(sum(rate(sambhav_http_request_duration_seconds_count[15m])),1e-9)"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Vihaan answers by mode",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(sambhav_ai_requests_total[5m]))",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Vihaan latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sambhav_ai_latency_seconds_bucket{mode=\"ai\"}[10m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sambhav_ai_latency_seconds_bucket{mode=\"ai\"}[10m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sambhav_ai_first_token_seconds_bucket[10m])))",
     "legendFormat": "first token p50"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tokens",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (direction) (rate(sambhav_ai_tokens_total[10m]))",
     "legendFormat": "{{direction}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Spend by model (hourly)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (increase(sambhav_ai_cost_usd_total[1h]))",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Feedback",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (rating) (increase(sambhav_ai_feedback_total[1h]))",
     "legendFormat": "{{rating}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Tool calls",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool) (increase(sambhav_ai_tool_calls_total[1h]))",
