{
  "name": "@sambhav/api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/curriculum.json','dist/db/curriculum.json')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "start:prod": "node dist/db/migrate.js && node dist/db/seed.js && node dist/server.js",
    "db:seed:prod": "node dist/db/seed.js",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@sambhav/game-core": "1.0.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "drizzle-orm": "0.45.4",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "4.2.0",
    "socket.io": "4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  }
}
