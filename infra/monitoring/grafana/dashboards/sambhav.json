   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Answers by prompt version",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (prompt) (increase(sambhav_ai_requests_total{mode=\"ai\"}[1h]))",
     "legendFormat": "{{prompt}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "API p95 by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(sambhav_http_request_duration_seconds_bucket[10m]))))",
     "legendFormat": "{{route}}"
    }
   ]
  }
 ]
}